@page
@model SignUpModel
@{
    ViewData["Title"] = "Sign Up";
}

<h1>Sign Up</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label">Age</label>
        <input asp-for="Age" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ProfileDescription" class="form-label">
            Profile Description
        </label>
        <textarea asp-for="ProfileDescription" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Sign Up</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success mt-3">
        @Model.Message
    </div>
}